    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
