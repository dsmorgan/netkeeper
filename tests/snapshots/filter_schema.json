  "additionalProperties": false,
  "description": "The root: a predicate (or none) and the archived-contacts switch.\n\nThe JSON schema carries ``x-netkeeper-fields``: each field's kind, label,\nthe ops it takes, and the values of an enum, for the builder.",
  "properties": {
    "where": {
      "anyOf": [
        {
          "$ref": "#/$defs/FilterNode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "include_archived": {
      "default": false,
      "title": "Include Archived",
      "type": "boolean"
    }
  },
  "title": "FilterTree",
  "type": "object",
  "x-netkeeper-fields": {
    "archived_at": {
      "kind": "datetime",
      "label": "archived",
      "ops": [
        "eq",
        "neq",
        "is_empty",
        "gt",
        "gte",
        "lt",
        "lte",
        "between"
      ]
    },
    "connected_on": {
      "kind": "date",
      "label": "connected on",
      "ops": [
        "eq",
        "neq",
        "is_empty",
        "gt",
        "gte",
        "lt",
        "lte",
        "between"
      ]
    },
    "created_at": {
      "kind": "datetime",
      "label": "created",
      "ops": [
        "eq",
        "neq",
        "is_empty",
        "gt",
        "gte",
        "lt",
        "lte",
        "between"
      ]
    },
    "current_company": {
      "kind": "string",
      "label": "company",
      "ops": [
        "eq",
        "neq",
        "contains",
        "starts_with",
        "is_empty"
      ]
    },
    "current_title": {
      "kind": "string",
      "label": "title",
      "ops": [
        "eq",
        "neq",
        "contains",
        "starts_with",
        "is_empty"
      ]
