        "field",
        "low",
        "high"
      ],
      "title": "Between",
      "type": "object"
    },
    "ChangedJobsWithinDays": {
      "additionalProperties": false,
      "description": "A ``contact_snapshots`` row observed in the last ``days`` days (spec 9.8).",
