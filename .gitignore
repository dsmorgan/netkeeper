# Local data and secrets. The data directory holds contacts, the browser profile,
# and backups; config.toml may hold personal merge fields.
data/
config.toml
*.sqlite3
*.sqlite3-*
.env
.env.*
chrome-profile/
backups/
exports/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/.tanstack/
*.tsbuildinfo

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Personal data used for testing. Real exports live in ~/code/netkeeper-private,
# outside every worktree; these patterns are a second line of defense in case one
# lands here anyway. Test fixtures are sanitized and committed under tests/fixtures.
*.xlsx
*.zip
Basic_LinkedInDataExport*
Connections.csv
Contacts.csv
messages.csv
Invitations.csv
*Campaign Statistics*

# The sanitized sample archive under tests/fixtures/archive is committed on
# purpose: its members carry the real export's file names because that is what
# the parser has to recognize, so the rules above would otherwise swallow them.
# Only .csv comes back, and only there; a real export dropped in that directory
# would still fail the suite, which asserts the sample's exact counts.
!tests/fixtures/archive/*.csv
